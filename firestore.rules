rules_version = '2';

// ===== Firestore 보안 규칙 =====
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 통째로 붙여 넣고 "게시"를 눌러요.
//
// 규칙 요약
// - 방문자는 자기 대화방(chats/자기ID)만 읽고 쓸 수 있어요. 다른 사람 대화는 못 봐요.
// - 주인(OWNER_UID)은 모든 대화방을 읽고, 답장하고, 지우고, 차단할 수 있어요.
// - 메시지는 1~500자 글자만, 한 번 보낸 메시지는 고칠 수 없어요.
// - 닉네임은 1~20자예요.
// - 스팸 방지: 방문자는 3초에 한 번만 메시지를 보낼 수 있어요.
//   (메시지와 대화방 정보를 한 번에(batch) 써야 하고, 대화방의 visitorAt 시간으로 간격을 검사해요.)
// - 차단: blocked/방문자ID 문서가 있으면 그 방문자는 더 이상 쓸 수 없어요.
// - 방문자는 "주인이 보낸 것처럼"(lastFrom: 'owner') 꾸밀 수 없어요.
// - 설문 답(surveys)은 방문자가 자기 것만 쓸 수 있고, 주인만 읽을 수 있어요.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == "OFskOBSHHVX4JUi3AhZCoG93jl12";
    }
    function isSelf(chatId) {
      return request.auth != null && request.auth.uid == chatId;
    }
    function isBlocked(chatId) {
      return exists(/databases/$(database)/documents/blocked/$(chatId));
    }

    // 대화방 문서의 모양 검사 (주인, 방문자 공통)
    function chatShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'updatedAt', 'lastText', 'lastFrom', 'unreadByOwner', 'lang', 'visitorAt'])
        && (!('lastText' in d) || (d.lastText is string && d.lastText.size() <= 500))
        && (!('nickname' in d) || (d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20));
    }

    // 방문자가 대화방 문서를 바꿀 때 지켜야 하는 것 (old = 바꾸기 전 내용, 처음이면 {})
    function visitorChatOk(chatId, old) {
      let d = request.resource.data;
      let changed = d.diff(old).affectedKeys();
      let sending = changed.hasAny(['visitorAt']);
      return !isBlocked(chatId)
        // 주인 흉내 금지
        && (!changed.hasAny(['lastFrom']) || d.lastFrom == 'visitor')
        && (!changed.hasAny(['unreadByOwner']) || d.unreadByOwner == true)
        && (!changed.hasAny(['updatedAt']) || d.updatedAt == request.time)
        // 마지막 메시지 정보는 "보내기"할 때만 바꿀 수 있어요
        && (!changed.hasAny(['lastText', 'lastFrom', 'updatedAt', 'unreadByOwner']) || sending)
        // 보내기: 지금 시간이어야 하고, 지난번 보내기보다 3초 이상 뒤여야 해요
        && (!sending || (d.visitorAt == request.time
            && (!('visitorAt' in old) || request.time > old.visitorAt + duration.value(3, 's'))));
    }

    match /chats/{chatId} {
      allow read: if isOwner() || isSelf(chatId);
      allow create: if chatShapeOk()
        && (isOwner() || (isSelf(chatId) && visitorChatOk(chatId, {})));
      allow update: if chatShapeOk()
        && (isOwner() || (isSelf(chatId) && visitorChatOk(chatId, resource.data)));
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isOwner() || isSelf(chatId);
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && ((isOwner() && request.resource.data.from == 'owner')
              || (isSelf(chatId)
                  && request.resource.data.from == 'visitor'
                  && !isBlocked(chatId)
                  // 같은 batch에서 대화방의 visitorAt 도 지금 시간으로 바뀌어야 해요 (= 3초 검사를 통과)
                  && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.visitorAt == request.time));
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // 설문 답: 방문자는 자기 답 하나만 쓸 수 있고(정해진 보기 중에서만), 읽는 건 주인만 할 수 있어요.
    match /surveys/{uid} {
      allow read, delete: if isOwner();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['gender', 'age', 'source', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['gender', 'age', 'source', 'lang', 'createdAt'])
        && request.resource.data.gender in ['male', 'female', 'other', 'secret']
        && request.resource.data.age in ['u13', '14-16', '17-19', '20-24', '25+', 'secret']
        && request.resource.data.source in ['discord', 'instagram', 'tiktok', 'facebook', 'friend', 'other']
        && request.resource.data.lang in ['ko', 'en', 'vi']
        && request.resource.data.createdAt == request.time;
    }

    // 차단 목록: 주인만 쓰고, 방문자는 자기가 차단됐는지만 볼 수 있어요.
    match /blocked/{chatId} {
      allow read: if isOwner() || isSelf(chatId);
      allow write: if isOwner();
    }
  }
}
